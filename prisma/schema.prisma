generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String             @id @default(uuid())
  clerkUserId            String             @unique
  username               String             @unique
  email                  String?            @unique
  mobile                 String?            @unique
  firstName              String?
  lastName               String?
  shopName               String?
  address                String?
  gender                 Gender?
  profileImageUrl        String?
  subscriptionStatus     SubscriptionStatus @default(expired)
  subscriptionEndDate    DateTime?
  razorpaySubscriptionId String?            @unique
  subscriptionPlan       SubscriptionPlan?
  razorpayPaymentId      String?
  subscriptionCreatedAt  DateTime?
  lastGraceExpiredAt     DateTime?
  hadTrial               Boolean            @default(false)
  isActive               Boolean            @default(true)
  lastLoginAt            DateTime?
  deletedAt              DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  customerTerms          String?
  shopownerTerms         String?
  customers              Customer[]
  alerts                 PledgeAlert[]
  tasks                  Task[]
  financialSnapshot      FinancialSnapshot[]
  customItemTypes        PledgeItemType[]
  inventoryItems         InventoryItem[]

  @@index([razorpaySubscriptionId])
  @@index([subscriptionStatus, isActive])
  @@map("users")
}

model Customer {
  id              String        @id @default(uuid())
  userId          String
  name            String
  region          String
  address         String
  mobile          String?
  viewToken       String        @unique @default(uuid())
  isPinned        Boolean       @default(false)
  isPortalBlocked Boolean       @default(false)
  idProofImg      String?
  customerImg     String?
  aadharNo        String?
  remark          String?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  gender          Gender?
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pledges         Pledge[]
  alerts          PledgeAlert[]

  @@index([userId, deletedAt])
  @@index([name])
  @@map("customers")
}

model Pledge {
  id                  String              @id @default(uuid())
  customerId          String
  pledgeDate          DateTime
  loanAmount          Decimal             @db.Decimal(12, 2)
  interestRate        Decimal             @db.Decimal(5, 2)
  compoundingDuration CompoundingDuration
  allowCompounding    Boolean             @default(true)
  itemPhoto           String?
  remark              String?
  durationMonths      Decimal?            @db.Decimal(6, 2)
  status              PledgeStatus
  releaseDate         DateTime?
  netWeightOfGold     Decimal             @default(0) @db.Decimal(10, 3)
  netWeightOfSilver   Decimal             @default(0) @db.Decimal(10, 3)
  totalInterest       Decimal?            @db.Decimal(12, 2)
  receivableAmount    Decimal?            @db.Decimal(12, 2)
  calculationVersion  Int                 @default(1)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  lastCalculatedLtv   Decimal?            @db.Decimal(8, 2)
  lastRiskTier        RiskTier?
  lastEvaluatedAt     DateTime?
  lastAmountOwed      Decimal?            @db.Decimal(14, 2)
  lastMarketValue     Decimal?            @db.Decimal(14, 2)
  salePrice           Decimal?            @db.Decimal(12, 2)
  pledgeAudits        PledgeAudit[]
  items               PledgeItem[]
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions        Transaction[]
  alerts              PledgeAlert[]
  inventoryItem       InventoryItem?

  @@index([status, createdAt])
  @@index([customerId, status])
  @@map("pledges")
}

model PledgeItemType {
  id        String   @id @default(uuid())
  label     String
  isDefault Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isDefault])
  @@map("pledge_item_types")
}

model PledgeItem {
  id               String    @id @default(uuid())
  pledgeId         String
  itemType         String
  metalType        MetalType
  itemName         String?
  quantity         Int       @default(1)
  grossWeight      Decimal   @db.Decimal(10, 3)
  netWeight        Decimal   @db.Decimal(10, 3)
  purity           Decimal   @db.Decimal(5, 2)
  netWeightOfMetal Decimal   @db.Decimal(10, 3)
  createdAt        DateTime  @default(now())
  pledge           Pledge    @relation(fields: [pledgeId], references: [id], onDelete: Cascade)

  @@index([pledgeId])
  @@map("pledge_items")
}

model PledgeAlert {
  id         String    @id @default(uuid())
  userId     String
  pledgeId   String
  customerId String
  oldTier    RiskTier?
  newTier    RiskTier
  alertType  AlertType
  message    String
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pledge     Pledge    @relation(fields: [pledgeId], references: [id], onDelete: Cascade)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@index([pledgeId])
  @@map("pledge_alerts")
}

model PledgeAudit {
  id                   String              @id @default(uuid())
  pledgeId             String
  action               AuditAction
  principal            Decimal             @db.Decimal(12, 2)
  interestRate         Decimal             @db.Decimal(5, 2)
  allowCompounding     Boolean
  compoundingDuration  CompoundingDuration
  calculationVersion   Int
  durationMonths       Decimal?            @db.Decimal(6, 2)
  netWeightOfGold      Decimal             @db.Decimal(10, 3)
  netWeightOfSilver    Decimal             @db.Decimal(10, 3)
  goldPricePerGram     Decimal?            @db.Decimal(10, 2)
  silverPricePerGram   Decimal?            @db.Decimal(10, 2)
  marketValueAtRelease Decimal?            @db.Decimal(12, 2)
  ltvAtRelease         Decimal?            @db.Decimal(5, 2)
  totalInterest        Decimal?            @db.Decimal(12, 2)
  receivableAmount     Decimal?            @db.Decimal(12, 2)
  releaseDate          DateTime?
  createdAt            DateTime            @default(now())
  pledge               Pledge              @relation(fields: [pledgeId], references: [id], onDelete: Cascade)

  @@index([pledgeId, createdAt])
  @@map("pledge_audits")
}

model MetalPrice {
  id          String    @id @default(cuid())
  metal       MetalType
  usdPerOunce Decimal   @db.Decimal(12, 4)
  inrPerGram  Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdAt])
  @@index([metal, createdAt(sort: Desc)])
}

model Transaction {
  id        String          @id @default(uuid())
  pledgeId  String
  amount    Decimal         @db.Decimal(12, 2)
  type      TransactionType
  note      String?
  createdAt DateTime        @default(now())
  pledge    Pledge          @relation(fields: [pledgeId], references: [id], onDelete: Cascade)

  @@index([pledgeId, createdAt(sort: Desc)])
  @@map("transactions")
}

model FinancialSnapshot {
  id                 String  @id @default(cuid())
  userId             String
  totalLoanAmount    Decimal @db.Decimal(14, 2)
  totalAmountOwed    Decimal @db.Decimal(14, 2)
  totalInterestOwed  Decimal @db.Decimal(14, 2)
  totalMarketValue   Decimal @db.Decimal(14, 2)
  goldPricePerGram   Decimal @db.Decimal(10, 2)
  silverPricePerGram Decimal @db.Decimal(10, 2)
  overallLtv         Decimal @db.Decimal(5, 2)
  totalGoldWeight    Decimal @db.Decimal(14, 3)
  totalSilverWeight  Decimal @db.Decimal(14, 3)
  totalPledges       Int
  activePledges      Int
  releasedPledges    Int
  overduePledges     Int
  safePledges        Int
  watchPledges       Int
  atRiskPledges      Int
  underwaterPledges  Int
  mtdNewPledges      Int      @default(0)
  mtdReleasedPledges Int      @default(0)
  mtdLoanAmount      Decimal  @default(0) @db.Decimal(14, 2)
  calculatedAt       DateTime @default(now())
  snapshotDate       DateTime
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapshotDate])
  @@index([userId, calculatedAt(sort: Desc)])
  @@map("financial_snapshots")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  from      String
  to        String
  rate      Float
  createdAt DateTime @default(now())

  @@index([from, to, createdAt(sort: Desc)])
}

enum TransactionType {
  REPAYMENT_PRINCIPAL
  REPAYMENT_INTEREST
  TOPUP
}

enum Gender {
  Male
  Female
  Other
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  title       String
  isDone      Boolean   @default(false)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tasks")
}

enum AuditAction {
  CREATED
  UPDATED
  RELEASED
  DELETED
  RECALCULATED
  SOLD
}

enum SubscriptionPlan {
  halfyearly
  yearly
}

enum SubscriptionStatus {
  trial
  created
  active
  halted
  expired
}

enum MetalType {
  GOLD
  SILVER
}

enum PledgeStatus {
  ACTIVE
  RELEASED
  OVERDUE
  SOLD
}

enum CompoundingDuration {
  MONTHLY
  HALFYEARLY
  YEARLY
}

enum RiskTier {
  SAFE
  WATCH
  AT_RISK
  UNDERWATER
}

enum AlertType {
  TIER_CHANGE
  CRITICAL
  INFO
}

enum InventorySource {
  PLEDGE_SALE
  DIRECT_PURCHASE
}

enum InventoryStatus {
  IN_STOCK
  SOLD
}

model InventoryItem {
  id             String          @id @default(uuid())
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Source
  sourceType     InventorySource
  sourcePledgeId String?         @unique
  sourcePledge   Pledge?         @relation(fields: [sourcePledgeId], references: [id], onDelete: SetNull)

  // Item details
  description    String
  itemType       String
  metalType      String
  purity         Decimal?        @db.Decimal(6, 3)
  grossWeight        Decimal     @db.Decimal(10, 3)
  netWeightOfGold    Decimal     @default(0) @db.Decimal(10, 3)
  netWeightOfSilver  Decimal     @default(0) @db.Decimal(10, 3)
  photoUrl       String?

  // Acquisition
  acquiredAt         DateTime        @default(now())
  acquiredCost       Decimal         @db.Decimal(12, 2)
  amountOwedAt       Decimal?        @db.Decimal(12, 2)
  acquiredMetalRate  Decimal?        @db.Decimal(10, 2)
  sellerName         String?
  sellerIdNum        String?

  // Sale
  status         InventoryStatus @default(IN_STOCK)
  soldAt         DateTime?
  soldPrice      Decimal?        @db.Decimal(12, 2)
  buyerName      String?
  buyerMobile    String?
  saleNotes      String?

  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([ownerId, status])
  @@index([ownerId, sourceType])
  @@index([ownerId, createdAt])
  @@index([sourcePledgeId])
  @@map("inventory_items")
}