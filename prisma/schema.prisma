generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String             @id @default(uuid())
  clerkUserId            String             @unique
  username               String             @unique
  email                  String?            @unique
  mobile                 String?            @unique
  firstName              String?
  lastName               String?
  shopName               String?
  address                String?
  gender                 Gender?
  profileImageUrl        String?
  subscriptionStatus     SubscriptionStatus @default(created)
  subscriptionEndDate    DateTime?
  razorpaySubscriptionId String?            @unique
  subscriptionPlan       SubscriptionPlan?
  razorpayPaymentId      String?
  subscriptionCreatedAt  DateTime?
  hadTrial               Boolean            @default(false)
  isActive               Boolean            @default(true)
  lastLoginAt            DateTime?
  deletedAt              DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  customerTerms          String?
  shopownerTerms         String?
  customers              Customer[]

   alerts            PledgeAlert[]
  financialSnapshot FinancialSnapshot[]
  @@index([razorpaySubscriptionId])
  @@index([subscriptionStatus, isActive])
  @@map("users")
}

model Customer {
  id              String    @id @default(uuid())
  userId          String
  name            String
  region          String
  address         String
  mobile          String?
  viewToken       String    @unique @default(uuid())
  isPortalBlocked Boolean   @default(false)
  idProofImg      String?
  customerImg     String?
  aadharNo        String?
  remark          String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  gender          Gender?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pledges         Pledge[]
  alerts  PledgeAlert[]
  @@index([userId])
  @@index([name])
  @@map("customers")
}

model Pledge {
  id                  String              @id @default(uuid())
  customerId          String
  pledgeDate          DateTime
  loanAmount          Decimal             @db.Decimal(12, 2)
  interestRate        Decimal             @db.Decimal(5, 2)
  compoundingDuration CompoundingDuration
  allowCompounding    Boolean             @default(true)
  itemPhoto           String?
  remark              String?
  durationMonths      Decimal?            @db.Decimal(6, 2)
  status              PledgeStatus
  releaseDate         DateTime?
  netWeightOfGold     Decimal             @default(0) @db.Decimal(10, 3)
  netWeightOfSilver   Decimal             @default(0) @db.Decimal(10, 3)
  totalInterest       Decimal?            @db.Decimal(12, 2)
  receivableAmount    Decimal?            @db.Decimal(12, 2)
  calculationVersion  Int                 @default(1)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  pledgeAudits        PledgeAudit[]
  items               PledgeItem[]
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions        Transaction[]


  //snapshot notification
  lastCalculatedLtv  Decimal?  @db.Decimal(5,2)
  lastRiskTier       RiskTier?
  lastEvaluatedAt    DateTime?
  alerts             PledgeAlert[]
  lastAmountOwed   Decimal? @db.Decimal(14,2)
lastMarketValue  Decimal? @db.Decimal(14,2)

  @@index([status, createdAt])
  @@index([customerId])
  @@map("pledges")
}

model PledgeItem {
  id               String    @id @default(uuid())
  pledgeId         String
  itemType         ItemType
  metalType        MetalType
  itemName         String?
  quantity         Int       @default(1)
  grossWeight      Decimal   @db.Decimal(10, 3)
  netWeight        Decimal   @db.Decimal(10, 3)
  purity           Decimal   @db.Decimal(5, 2)
  netWeightOfMetal Decimal   @db.Decimal(10, 3)
  createdAt        DateTime  @default(now())
  pledge           Pledge    @relation(fields: [pledgeId], references: [id], onDelete: Cascade)

  @@index([pledgeId])
  @@map("pledge_items")
}
model PledgeAlert {
  id         String    @id @default(uuid())
  userId     String
  pledgeId   String
  customerId String

  oldTier    RiskTier?
  newTier    RiskTier
  alertType  AlertType
  message    String
  isRead     Boolean   @default(false)

  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pledge     Pledge    @relation(fields: [pledgeId], references: [id], onDelete: Cascade)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@index([pledgeId])
  @@map("pledge_alerts")
}

model PledgeAudit {
  id                   String              @id @default(uuid())
  pledgeId             String
  action               AuditAction
  principal            Decimal             @db.Decimal(12, 2)
  interestRate         Decimal             @db.Decimal(5, 2)
  allowCompounding     Boolean
  compoundingDuration  CompoundingDuration
  calculationVersion   Int
  durationMonths       Decimal?            @db.Decimal(6, 2)
  netWeightOfGold      Decimal             @db.Decimal(10, 3)
  netWeightOfSilver    Decimal             @db.Decimal(10, 3)
  goldPricePerGram     Decimal?            @db.Decimal(10, 2)
  silverPricePerGram   Decimal?            @db.Decimal(10, 2)
  marketValueAtRelease Decimal?            @db.Decimal(12, 2)
  ltvAtRelease         Decimal?            @db.Decimal(5, 2)
  totalInterest        Decimal?            @db.Decimal(12, 2)
  receivableAmount     Decimal?            @db.Decimal(12, 2)
  releaseDate          DateTime?
  createdAt            DateTime            @default(now())
  pledge               Pledge              @relation(fields: [pledgeId], references: [id], onDelete: Cascade)

  @@index([pledgeId])
  @@map("pledge_audits")
}

model MetalPrice {
  id          String    @id @default(cuid())
  metal       MetalType
  usdPerOunce Decimal   @db.Decimal(12, 4)
  inrPerGram  Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdAt])
  @@index([metal, createdAt(sort: Desc)])
}

model Transaction {
  id        String          @id @default(uuid())
  pledgeId  String
  amount    Decimal         @db.Decimal(12, 2)
  type      TransactionType
  note      String?
  createdAt DateTime        @default(now())
  pledge    Pledge          @relation(fields: [pledgeId], references: [id], onDelete: Cascade)

  @@index([pledgeId, createdAt(sort: Desc)])
  @@map("transactions")
}

model FinancialSnapshot {
  id     String @id @default(cuid())
  userId String

  // Loan
  totalLoanAmount   Decimal @db.Decimal(14,2)
  totalAmountOwed   Decimal @db.Decimal(14,2)
  totalInterestOwed Decimal @db.Decimal(14,2)

  // Market
  totalMarketValue   Decimal @db.Decimal(14,2)
  goldPricePerGram   Decimal @db.Decimal(10,2)
  silverPricePerGram Decimal @db.Decimal(10,2)

  // LTV
  overallLtv Decimal @db.Decimal(5,2)

  // Weight
  totalGoldWeight   Decimal @db.Decimal(14,3)
  totalSilverWeight Decimal @db.Decimal(14,3)

  // Pledge counts — lifetime totals
  totalPledges    Int   // ← all pledges ever created
  activePledges   Int
  releasedPledges Int   // ← all time released
  overduePledges  Int

  // Risk tier breakdown (active only)
  safePledges      Int
  watchPledges     Int
  atRiskPledges    Int
  underwaterPledges Int

 

  calculatedAt DateTime @default(now())
  snapshotDate     DateTime
@@unique([userId, snapshotDate])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, calculatedAt(sort: Desc)])
  @@map("financial_snapshots")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  from      String
  to        String
  rate      Float
  createdAt DateTime @default(now())

  @@index([from, to, createdAt(sort: Desc)])
}

enum TransactionType {
  REPAYMENT_PRINCIPAL
  REPAYMENT_INTEREST
  TOPUP
}

enum Gender {
  Male
  Female
  Other
}

enum AuditAction {
  CREATED
  UPDATED
  RELEASED
  DELETED
  RECALCULATED
}

enum SubscriptionPlan {
  halfyearly
  yearly
}

enum SubscriptionStatus {
  trial
  created
  active
  halted
  expired
}

enum ItemType {
  NECKLACE
  CHAIN
  RING
  BANGLE
  BRACELET
  EARRING
  ANKLET
  PENDANT
  COIN
  BAR
  OTHER
}

enum MetalType {
  GOLD
  SILVER
}

enum PledgeStatus {
  ACTIVE
  RELEASED
  OVERDUE
}

enum CompoundingDuration {
  MONTHLY
  HALFYEARLY
  YEARLY
}

enum RiskTier {
  SAFE
  WATCH
  AT_RISK
  UNDERWATER
}

enum AlertType {
  TIER_CHANGE
  CRITICAL
  INFO
}
