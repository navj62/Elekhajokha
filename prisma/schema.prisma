generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String             @id @default(uuid())
  clerkUserId            String             @unique
  

  // Identity (available at signup)
  username      String  @unique
  email         String?  @unique
  mobile        String?  @unique

  // Profile (filled during onboarding)
  firstName     String?
  lastName      String?
  shopName      String?
  address       String?
  gender        Gender?
  profileImageUrl String?

  // Subscription (managed later)
  subscriptionStatus   SubscriptionStatus @default( created )
  subscriptionEndDate  DateTime?
  razorpaySubscriptionId  String?            @unique   // ← ADD: links webhook to user
  subscriptionPlan    SubscriptionPlan?                    // ← ADD: "halfyearly" | "yearly"
   razorpayPaymentId  String? 
   subscriptionCreatedAt DateTime? // set when create-subscription API is called
   hadTrial                Boolean   @default(false)  // ← ADD THIS
  // System
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shopownerTerms  String?  // custom T&C for shopowner copy
  customerTerms   String?  // custom T&C for customer copy

  customers     Customer[]
   @@index([razorpaySubscriptionId])  
  @@index([subscriptionStatus, isActive])
  @@map("users")
}

model Customer {
  id              String    @id @default(uuid())
  userId          String
  name            String
  region          String
  address         String
  mobile          String?
  viewToken       String    @unique @default(uuid())
  isPortalBlocked Boolean   @default(false)
  idProofImg      String?
  customerImg     String?
  aadharNo        String?
  remark          String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  gender          Gender?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pledges         Pledge[]

  @@index([userId])
  @@index([name])
  @@map("customers")
}

model Pledge {
  id                  String              @id @default(uuid())
  customerId          String
  pledgeDate          DateTime

  // Financial
  loanAmount          Decimal             @db.Decimal(12, 2)
  interestRate        Decimal             @db.Decimal(5, 2)
  compoundingDuration CompoundingDuration
  allowCompounding    Boolean             @default(true)
  durationMonths      Decimal?            @db.Decimal(6, 2)
  totalInterest       Decimal?            @db.Decimal(12, 2)
  receivableAmount    Decimal?            @db.Decimal(12, 2)
  calculationVersion  Int                 @default(1)
  status              PledgeStatus
  releaseDate         DateTime?
  remark              String?

  // ✅ Stored totals — always computed from items, never from user input
  netWeightOfGold     Decimal             @default(0) @db.Decimal(10, 3)
  netWeightOfSilver   Decimal             @default(0) @db.Decimal(10, 3)
   itemPhoto        String?   // ✅ moved here from Pledge
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items               PledgeItem[]
  pledgeAudits        PledgeAudit[]
  transactions        Transaction[]

  @@index([status, createdAt])
  @@index([customerId])
  @@map("pledges")
}

model PledgeItem {
  id               String    @id @default(uuid())
  pledgeId         String
  itemType         ItemType
  metalType        MetalType
  itemName         String?
  quantity         Int       @default(1)
  grossWeight      Decimal   @db.Decimal(10, 3)
  netWeight        Decimal   @db.Decimal(10, 3)
  purity           Decimal   @db.Decimal(5, 2)
  netWeightOfMetal Decimal   @db.Decimal(10, 3)
 

  createdAt        DateTime  @default(now())

  pledge           Pledge    @relation(fields: [pledgeId], references: [id], onDelete: Cascade)

  @@index([pledgeId])
  @@map("pledge_items")
}

model PledgeAudit {
  id                   String              @id @default(uuid())
  pledgeId             String
  action               AuditAction
  principal            Decimal             @db.Decimal(12, 2)
  interestRate         Decimal             @db.Decimal(5, 2)
  allowCompounding     Boolean
  compoundingDuration  CompoundingDuration
  calculationVersion   Int
  durationMonths       Decimal?            @db.Decimal(6, 2)
  netWeightOfGold      Decimal             @db.Decimal(10, 3)
  netWeightOfSilver    Decimal             @db.Decimal(10, 3)
  goldPricePerGram     Decimal?            @db.Decimal(10, 2)
  silverPricePerGram   Decimal?            @db.Decimal(10, 2)
  marketValueAtRelease Decimal?            @db.Decimal(12, 2)
  ltvAtRelease         Decimal?            @db.Decimal(5, 2)
  totalInterest        Decimal?            @db.Decimal(12, 2)
  receivableAmount     Decimal?            @db.Decimal(12, 2)
  releaseDate          DateTime?
  createdAt            DateTime            @default(now())
  pledge               Pledge              @relation(fields: [pledgeId], references: [id], onDelete: Cascade)

  @@index([pledgeId])
  @@map("pledge_audits")
}

model MetalPrice {
  id          String    @id @default(cuid())
  metal       MetalType
  usdPerOunce Decimal   @db.Decimal(12, 4)
  inrPerGram  Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdAt])
  @@index([metal, createdAt(sort: Desc)])
}

model Transaction {
  id        String          @id @default(uuid())
  pledgeId  String
  amount    Decimal         @db.Decimal(12, 2)
  type      TransactionType
  note      String?
  createdAt DateTime        @default(now())
  pledge    Pledge          @relation(fields: [pledgeId], references: [id], onDelete: Cascade)

  @@index([pledgeId, createdAt(sort: Desc)])
  @@map("transactions")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  from      String
  to        String
  rate      Float
  createdAt DateTime @default(now())

  @@index([from, to, createdAt(sort: Desc)])
}

enum TransactionType {
  REPAYMENT_PRINCIPAL
  REPAYMENT_INTEREST
  TOPUP
}

enum Gender {
  Male
  Female
  Other
}

enum AuditAction {
  CREATED
  UPDATED
  RELEASED
  DELETED
  RECALCULATED
}

enum SubscriptionPlan {
  halfyearly
  yearly
}

enum SubscriptionStatus {
  trial
  created
  active
  halted
  expired
}

enum ItemType {
  NECKLACE
  CHAIN
  RING
  BANGLE
  BRACELET
  EARRING
  ANKLET
  PENDANT
  COIN
  BAR
  OTHER
}

enum MetalType {
  GOLD
  SILVER
}

enum PledgeStatus {
  ACTIVE
  RELEASED
  OVERDUE
}

enum CompoundingDuration {
  MONTHLY
  HALFYEARLY
  YEARLY
}
